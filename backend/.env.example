# ── Glow & Glam Backend Environment Variables ──────────────────────────────
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/glow_and_glam_db

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=glow_and_glam_super_secure_jwt_secret_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=14

# ── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=false          # Set to true in production (HTTPS only)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=             # Leave blank for localhost

# ── Password Reset ────────────────────────────────────────────────────────────
RESET_TOKEN_EXPIRE_MINUTES=30

# ── SMTP (optional – used for password reset emails) ─────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hello@yourshop.com
# SMTP_PASSWORD=your_app_password
# EMAILS_FROM=hello@glowandglam.com
